PORT=4000

# Supabase project that backs the CMS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxx
# Server-side only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Must be >= 32 chars. The server refuses to start in production without it.
JWT_SECRET=generate-with-openssl-rand-hex-32

RESEND_API_KEY=re_xxxxx
CONTACT_TO_EMAIL=hello@qodily.dz

# Comma-separated exact origins. Wildcard Railway subdomains are no longer
# trusted, so list the production frontend explicitly.
CORS_ORIGIN=http://localhost:3000,https://qodily-dz-production.up.railway.app
